# ==============================================================================
# OPALITE ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# NOTE: All variables below are OPTIONAL for standalone frontend deployment.
# If no environment variables are configured, Opalite automatically runs in
# standalone local-mock mode with full browser storage persistence.
#
# Copy this template to `.env.local` for local overrides.
# Never commit `.env` or `.env.local` containing production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. External APIs (Client-side / Public)
# ------------------------------------------------------------------------------
# Pixabay Image Search (Optional)
# Enables live stock image search in the Explore section.
# If omitted or empty, Explore uses Opalite's curated high-resolution design imagery.
NEXT_PUBLIC_PIXABAY_API_KEY=

# ------------------------------------------------------------------------------
# 2. External APIs (Server-side / Secret)
# ------------------------------------------------------------------------------
# Google Fonts Developer API Key (Optional)
# Official Google Fonts API key for the `/api/fonts` catalogue endpoint.
# If omitted, Opalite seamlessly falls back to Google's public metadata catalogue
# and curated local font specimens with zero runtime interruption.
GOOGLE_FONTS_API_KEY=

# ------------------------------------------------------------------------------
# 3. Database Connection (Server-side / Secret)
# ------------------------------------------------------------------------------
# Database URL for Prisma ORM.
# Local development default: "file:./dev.db" (SQLite)
# Production Vercel default: Managed PostgreSQL, Neon, or Supabase connection string.
# If unset, Opalite defaults to local SQLite without crashing serverless routes.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 4. Firebase Configuration (Client-side / Public)
# ------------------------------------------------------------------------------
# When populated with live project credentials, Opalite connects to Firebase Auth,
# Firestore, and Firebase Storage.
# If unset or set to demo keys, Opalite runs in Standalone Mock Mode with
# instant local authentication and zero-latency browser persistence.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=opalite-studio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=opalite-studio
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=opalite-studio.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 5. Application URL (Optional)
# ------------------------------------------------------------------------------
# Used for absolute URL generation in server-side contexts.
# In the browser, Opalite automatically uses window.location.origin.
NEXT_PUBLIC_APP_URL=
