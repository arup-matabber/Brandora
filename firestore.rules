rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProjectOwner(projectId) {
      return isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId
      );
    }

    function isProjectMember(projectId) {
      return isAuthenticated() && (
        isProjectOwner(projectId) ||
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid))
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // prevent accidental account deletion

      // User's private Creative Library
      match /library/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Clients collection - designer can only access their own clients
    match /clients/{clientId} {
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.ownerId == request.auth.uid
      ) && (
        request.resource == null || request.resource.data.ownerId == request.auth.uid
      );
    }

    // 3. Projects collection
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid))
      );

      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role in ['owner', 'editor']
      );

      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Project members subcollection
      match /members/{memberId} {
        allow read: if isProjectMember(projectId);
        allow write: if isProjectOwner(projectId);
      }

      // Project materials subcollection
      match /materials/{materialId} {
        allow read: if isProjectMember(projectId);
        allow create, update: if isProjectMember(projectId);
        allow delete: if isProjectOwner(projectId);
      }

      // Project items subcollection (Library items associated with project)
      match /items/{itemId} {
        allow read, write: if isProjectMember(projectId);
      }

      // Project canvas documents & canvas objects subcollection
      match /canvas/{canvasId} {
        allow read, write: if isProjectMember(projectId);

        match /objects/{objectId} {
          allow read, write: if isProjectMember(projectId);
        }
      }

      // Project directions & immutable published version snapshots
      match /directions/{directionId} {
        allow read, write: if isProjectMember(projectId);

        match /versions/{versionId} {
          // Member can view all versions; client review can view published versions
          allow read: if isProjectMember(projectId) || resource.data.status == "PUBLISHED";
          allow write: if isProjectMember(projectId);
        }
      }

      // Project client reviews, comments, and approvals
      match /reviews/{reviewId} {
        allow read: if isProjectMember(projectId) || resource.data.status != "closed";
        allow write: if isProjectMember(projectId);

        match /comments/{commentId} {
          allow read: if true;
          allow create: if request.resource.data.reviewId == reviewId;
          allow update: if isProjectMember(projectId) || request.resource.data.reviewId == reviewId;
          allow delete: if isProjectMember(projectId);
        }

        match /approvals/{approvalId} {
          allow read: if true;
          allow create: if request.resource.data.reviewId == reviewId;
          allow update, delete: if isProjectMember(projectId);
        }
      }
    }

    // 4. Secure opaque review share tokens for client portal access
    match /reviewShares/{token} {
      allow read: if resource == null || resource.data.active == true;
      allow write: if isAuthenticated();
    }
  }
}
